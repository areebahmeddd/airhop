{
  "name": "airhop",
  "version": "1.0.0",
  "description": "Private, offline-first messenger",
  "keywords": [
    "airhop",
    "messenger",
    "bluetooth",
    "p2p",
    "mesh-network",
    "offline-communication",
    "encrypted",
    "nostr",
    "cashu"
  ],
  "author": "Areeb Ahmed <hi@areeb.dev>",
  "license": "MIT",
  "homepage": "https://airhop.1mindlabs.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/areebahmeddd/airhop"
  },
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:release": "expo run:android --variant release",
    "ios": "expo run:ios",
    "ios:release": "expo run:ios --configuration Release",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "coverage": "jest --passWithNoTests --coverage",
    "i18n:audit": "node scripts/i18n-audit.js",
    "i18n:native": "node scripts/i18n-check-native.js",
    "verify:vendored": "node scripts/verify-vendored.js",
    "verify:invisibles": "node scripts/check-invisibles.js",
    "deadcode": "knip --no-progress && knip --production --no-progress",
    "benchmark": "jest --runInBand --testMatch \"**/__benchmarks__/**/*.bench.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.13.0",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@react-native-vector-icons/feather": "^14.0.0",
    "@react-native-vector-icons/material-design-icons": "^14.0.0",
    "@scure/bip39": "^2.4.0",
    "expo": "~58.0.20",
    "expo-asset": "~58.0.18",
    "expo-audio": "~58.0.10",
    "expo-camera": "~58.0.13",
    "expo-clipboard": "~58.0.4",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.12",
    "expo-font": "~58.0.10",
    "expo-haptics": "~58.0.7",
    "expo-image-manipulator": "~58.0.15",
    "expo-image-picker": "~58.0.10",
    "expo-intent-launcher": "~58.0.3",
    "expo-local-authentication": "~58.0.2",
    "expo-localization": "~58.0.5",
    "expo-location": "~58.0.19",
    "expo-media-library": "~58.0.12",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-notifications": "~58.1.6",
    "expo-screen-capture": "~58.0.6",
    "expo-secure-store": "~58.0.2",
    "expo-sharing": "~58.0.20",
    "expo-status-bar": "~58.0.4",
    "expo-system-ui": "~58.0.6",
    "expo-video": "~58.0.12",
    "nostr-tools": "^2.25.2",
    "pako": "^3.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "~2.0.0",
    "react-native-mmkv": "^4.3.2",
    "react-native-nitro-modules": "^0.37.1",
    "react-native-qrcode-svg": "^6.3.44",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/jest-preset": "0.88.0",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.21",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "globals": "^17.13.0",
    "jest": "^30.5.2",
    "jest-environment-node": "^30.5.2",
    "jest-expo": "~58.0.12",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "test-renderer": "1.3.0",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testEnvironment": "<rootDir>/src/__tests__/harness/node-environment.js",
    "testMatch": [
      "**/*.test.[jt]s?(x)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/native/arti/target/",
      "<rootDir>/.native-build/"
    ],
    "transformIgnorePatterns": [
      "node_modules/(?!(@noble|@scure|nostr-tools|@cashu|react-native|@react-native|expo|@expo|@unimodules|unimodules|react-native-reanimated))"
    ],
    "moduleNameMapper": {
      "^@noble/curves/(.+?)(\\.js)?$": "<rootDir>/node_modules/@noble/curves/$1.js",
      "^@noble/hashes/(.+?)(\\.js)?$": "<rootDir>/node_modules/@noble/hashes/$1.js",
      "^@noble/ciphers/(.+?)(\\.js)?$": "<rootDir>/node_modules/@noble/ciphers/$1.js",
      "^expo-secure-store$": "<rootDir>/src/__mocks__/expo-secure-store.js",
      "^expo-audio$": "<rootDir>/src/__mocks__/expo-audio.js",
      "^expo-network$": "<rootDir>/src/__mocks__/expo-network.js",
      "^expo-localization$": "<rootDir>/src/__mocks__/expo-localization.js",
      "^@app/(.*)$": "<rootDir>/src/app/$1",
      "^@bridge/(.*)$": "<rootDir>/src/bridge/$1",
      "^@core/(.*)$": "<rootDir>/src/core/$1",
      "^@data/(.*)$": "<rootDir>/src/data/$1",
      "^@features/(.*)$": "<rootDir>/src/features/$1",
      "^@i18n$": "<rootDir>/src/i18n",
      "^@i18n/(.*)$": "<rootDir>/src/i18n/$1",
      "^@platform/(.*)$": "<rootDir>/src/platform/$1",
      "^@services/(.*)$": "<rootDir>/src/services/$1",
      "^@store/(.*)$": "<rootDir>/src/store/$1",
      "^@ui/(.*)$": "<rootDir>/src/ui/$1",
      "^@utils/(.*)$": "<rootDir>/src/utils/$1"
    }
  }
}
