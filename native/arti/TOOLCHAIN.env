# Pinned inputs used to build and package the shipped Tor binaries.
# Keep these values in sync with the corresponding build and package files.
# Regenerate SHA256SUMS in the same commit when any archive changes.

# Arti and Rust toolchain.
# ARTI_CLIENT_VERSION must match arti-client and tor-rtcompat in Cargo.toml.
# RUST_VERSION must match rust-toolchain.toml.
ARTI_CLIENT_VERSION=0.46.0
RUST_VERSION=1.98.1
CARGO_NDK_VERSION=4.1.2

# cbindgen generates arti.h from src/ffi_c.rs.
# build-apple.sh pins and verifies this exact version.
CBINDGEN_VERSION=0.29.4

# Android NDK.
# NDK r28+ uses 16 KiB load-segment alignment by default, as required for
# 64-bit Android libraries distributed through Google Play.
# build-android.sh verifies the alignment after each build.
ANDROID_NDK_VERSION=28.2.13676358
ANDROID_NDK_ARCHIVE=android-ndk-r28c-linux.zip
ANDROID_NDK_SHA256=dfb20d396df28ca02a8c708314b814a4d961dc9074f9a161932746f815aa552f
REQUIRED_LOAD_ALIGNMENT=16384

# Android platform jar used by gomobile to compile generated Java bindings.
# This is independent of the app's compileSdk and is not a runtime API level.
# SHA1 is used because Google publishes platform archives with SHA1 checksums.
ANDROID_PLATFORM_API=36
ANDROID_PLATFORM_ARCHIVE=platform-36_r02.zip
ANDROID_PLATFORM_SHA1=2c1a80dd4d9f7d0e6dd336ec603d9b5c55a6f576

# Android minimum supported API level.
# Must match android.minSdkVersion in android/gradle.properties.
ANDROID_MIN_SDK=26

# iOS minimum deployment target.
# Must match ios/Arti.podspec.
IOS_MIN_VERSION=16.4

# Go toolchain for bundled pluggable transports.
# obfs4 and Snowflake are built into the mobile library for iOS, where they
# cannot be managed as child processes by Arti.
GO_VERSION=1.26.8
GO_ARCHIVE=go1.26.8.linux-amd64.tar.gz
GO_SHA256=d0f743b33e8d8945e6b1f432edd15785c70507121d6e2a723b21285eddf8b57b

# IPtProxy, which packages Lyrebird (obfs4) and Snowflake for mobile.
# Pin both the release and commit so the source cannot change behind a tag.
IPTPROXY_VERSION=5.5.1
IPTPROXY_COMMIT=d4878bf7729902c1fb5e319d3b043c81388e0720

# gomobile used to produce the iOS xcframework and Android AAR.
# IPtProxy pins this through go.mod; keep the exact version here because
# upstream's build script otherwise resolves @latest.
GOMOBILE_VERSION=v0.0.0-20260611195102-4dd8f1dbf5d2

# dnstt is pinned separately because IPtProxy references it through a
# replace directive rather than the module proxy.
DNSTT_COMMIT=f1b9b97a269f83bad41d2ceef291b4d2c161cd11

# Debian snapshot used for reproducible system package installation.
DEBIAN_SNAPSHOT=20260720T000000Z

# Fixed timestamp used for reproducible native builds.
NATIVE_SOURCE_DATE_EPOCH=1788307200
