{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["expo-updates", "expo-system-ui"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "App.tsx!",
        "src/**/__tests__/**/*.{ts,tsx}",
        "src/**/__benchmarks__/**/*.bench.ts",
        "scripts/*.js!"
      ],
      "project": ["src/**/*.{ts,tsx,js}!", "scripts/**/*.js!"]
    }
  }
}
