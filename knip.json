{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["expo-updates", "expo-system-ui"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "App.tsx!",
        "src/**/__tests__/**/*.{ts,tsx}",
        "src/**/__benchmarks__/**/*.bench.ts",
        "scripts/*.js!",
        "press/build.mjs!",
        "press/tools/*.mjs!"
      ],
      "project": [
        "src/**/*.{ts,tsx,js}!",
        "scripts/**/*.js!",
        "press/**/*.mjs!"
      ]
    },
    "press/film": {
      "entry": [
        "scripts/{build,hyperframes,narrate,render,score,score-trailer}.mjs!"
      ],
      "project": ["**/*.mjs!"],
      "ignoreBinaries": ["ffmpeg"],
      "ignoreDependencies": ["gsap", "@hyperframes/core", "feather-icons"]
    }
  }
}
