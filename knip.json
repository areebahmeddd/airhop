{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreDependencies": ["expo-updates", "react-test-renderer"],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "App.tsx",
        "src/**/__tests__/**/*.{ts,tsx}",
        "src/**/__benchmarks__/**/*.bench.ts",
        "scripts/*.js",
        "press/build.mjs",
        "press/tools/*.mjs"
      ],
      "project": ["src/**/*.{ts,tsx,js}", "scripts/**/*.js", "press/**/*.mjs"]
    }
  }
}
