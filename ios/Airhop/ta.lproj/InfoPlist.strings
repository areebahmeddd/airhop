/* Keys mirror ios/Airhop/Info.plist, the English copy. Guarded by npm run i18n:native. */

"NSBluetoothAlwaysUsageDescription" = "மெஷில் உள்ள அருகிலுள்ள சாதனங்களுடன் தொடர்புகொள்ள Airhop புளூடூத்தைப் பயன்படுத்துகிறது.";
"NSBluetoothPeripheralUsageDescription" = "அருகிலுள்ள பியர்களுக்கு நீங்கள் இருப்பதை அறிவிக்க Airhop புளூடூத்தைப் பயன்படுத்துகிறது.";
"NSLocalNetworkUsageDescription" = "பெரிய கோப்புகளை (வீடியோ, பெரிய கோப்புகள்) அனுப்ப அருகிலுள்ள சாதனங்களுடன் நேரடியாக இணைய Airhop உள்ளக நெட்வொர்க்கைப் பயன்படுத்துகிறது.";
"NSCameraUsageDescription" = "ஒரு தொடர்பின் QR குறியீட்டை ஸ்கேன் செய்யவும், அருகிலுள்ள பியர்களுடன் பகிரப் புகைப்படங்களையும் வீடியோக்களையும் எடுக்கவும் Airhop கேமராவைப் பயன்படுத்துகிறது.";
"NSMicrophoneUsageDescription" = "குரல் குறிப்புகளைப் பதிவுசெய்யவும், அருகிலுள்ள பியர்களுக்கு நேரடிக் குரலை எடுத்துச் செல்லவும் Airhop ஒலிவாங்கியைப் பயன்படுத்துகிறது.";
"NSPhotoLibraryUsageDescription" = "படங்களையும் வீடியோக்களையும் மெஷ் வழியாகப் பகிர Airhop உங்கள் புகைப்படத் தொகுப்பை அணுகுகிறது.";
"NSPhotoLibraryAddUsageDescription" = "நீங்கள் ஒன்றைச் சேமிக்கத் தேர்ந்தெடுக்கும்போதும், உங்கள் QR குறியீட்டைப் பதிவிறக்கும்போதும் Airhop புகைப்படங்களையும் வீடியோக்களையும் உங்கள் தொகுப்பில் சேமிக்கிறது.";
"NSFaceIDUsageDescription" = "உங்கள் அடையாளத்தைப் புதிய தொலைபேசிக்கு மாற்றும் முன், அது நீங்கள்தான் என உறுதிப்படுத்த Airhop Face ID ஐப் பயன்படுத்துகிறது.";
"NSLocationWhenInUseUsageDescription" = "அருகிலுள்ள பகுதிச் சேனல்களில் (நகரத் தொகுதி, நகரம், பகுதி) உங்களை வைக்க Airhop உங்கள் தோராயமான இடத்தைப் பயன்படுத்துகிறது. உங்கள் துல்லியமான இடம் ஒருபோதும் உங்கள் சாதனத்தை விட்டு வெளியேறாது.";
