<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Airhop</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>org.onemindlabs.airhop</string>
				<string>airhop</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<!-- Export compliance. Apple ships every app from the United States, so US
	     export rules attach to it whoever wrote it and wherever they live.

	     Read the key name carefully: it asks about NON-EXEMPT encryption, not
	     about encryption. Airhop plainly uses encryption, but under the EAR that
	     is only "non-standard cryptography" when the algorithm is proprietary or
	     unpublished. Every primitive here is a published standard - X25519
	     (RFC 7748), Ed25519 (RFC 8032), ChaCha20-Poly1305 (RFC 8439), SHA-256,
	     HKDF (RFC 5869), secp256k1 Schnorr (BIP-340) - composed by published
	     specifications: the Noise Protocol Framework, Signal's Double Ratchet,
	     and NIP-44. Nothing is invented here.

	     Publicly available encryption source code performing standard
	     cryptography is not subject to the EAR, and since a 2021 BIS rule it
	     carries no notification requirement either; that survives only for
	     non-standard cryptography. The repository being public under MIT is what
	     satisfies it, so there is nothing to file and nothing to renew.

	     What this does depend on is the source staying public. If Airhop is ever
	     closed, forked privately, or ships a binary whose source is not
	     published, this answer stops being true and has to be revisited. -->

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The App Store category, matching bitchat's. Set here as well as in App
	     Store Connect so the two cannot disagree. No LSMinimumSystemVersion: it
	     is a macOS key; the iOS floor is IPHONEOS_DEPLOYMENT_TARGET. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.social-networking</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Airhop uses Bluetooth to communicate with nearby devices on the mesh.</string>
	<key>NSBluetoothPeripheralUsageDescription</key>
	<string>Airhop uses Bluetooth to advertise your presence to nearby peers.</string>
	<!-- The LAN transport: mDNS discovery and TCP links over the network the
	     phone is on. Without this key iOS shows its own generic wording. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Airhop uses the local network to connect directly to nearby devices for high-bandwidth transfers (video, large files).</string>
	<!-- The mDNS service the LAN transport browses for. Declaring it is what
	     permits the browse; the prompt the string above fills fires on the first
	     one, not on this key.

	     Not Wi-Fi Aware's `_airhop-mesh-v1._tcp`. Two services, named apart so
	     neither reads as a typo of the other: Aware is a radio protocol needing
	     no network, this is mDNS over an ordinary one. -->
	<key>NSBonjourServices</key>
	<array>
		<string>_airhop-lan-v1._tcp</string>
	</array>
	<!-- Camera, microphone, photo library and location. Every usage string below
	     is also declared in app.json. This file is hand-maintained rather than
	     regenerated, so adding a permission to app.json alone changes nothing
	     here: add it in both places.

	     These are not optional. Without them iOS does not deny the request - it
	     terminates the process the moment AVCaptureDevice or AVAudioSession is
	     touched. -->
	<key>NSCameraUsageDescription</key>
	<string>Airhop uses the camera to scan a contact's QR code, and to capture photos and videos to share with nearby peers.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Airhop uses the microphone to record voice notes and to carry live voice to nearby peers.</string>
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Airhop accesses your photo library to share images and videos over the mesh.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Airhop saves photos and videos to your photo library when you choose to save one, and when you download your QR code.</string>
	<!-- Location resolves which geohash cell the location channels (#block,
	     #city, #region, and so on) belong to. Raw coordinates never leave the
	     device; only the truncated geohash is published. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Airhop uses your approximate location to place you in nearby area channels (block, city, region). Your exact position never leaves your device.</string>
	<key>RCTNewArchEnabled</key>
	<true/>
	<key>UIBackgroundModes</key>
	<array>
		<string>bluetooth-central</string>
		<string>bluetooth-peripheral</string>
	</array>
	<key>UILaunchStoryboardName</key>
	<string>SplashScreen</string>
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
	</array>
	<key>UIRequiresFullScreen</key>
	<false/>
	<key>UIStatusBarStyle</key>
	<string>UIStatusBarStyleDefault</string>
	<!-- Portrait only, matching app.json and the Android activity. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Automatic</string>
	<key>UIViewControllerBasedStatusBarAppearance</key>
	<false/>
	<!-- The Wi-Fi Aware service the same-platform fast path publishes and
	     subscribes to, backing AirhopWiFiModule.swift.

	     Three copies of one string, and all three have to agree: this key,
	     `WiFiConst.serviceName` in AirhopWiFiModule.swift, and `SERVICE_NAME`
	     in AirhopWiFiModule.kt. NAN derives the on-air service ID by hashing the
	     name, so one different character means two devices never match.

	     Apple requires DNS-SD form with a name component of at most 15
	     characters from [A-Za-z0-9-]; an invalid one traps the app on launch
	     rather than failing at use, which is why it is worth stating that here.

	     Both keys present because Airhop is symmetric: every device publishes so
	     it can be found and subscribes so it can find, and the framework
	     requires at least one of the two or it traps. -->
	<key>WiFiAwareServices</key>
	<dict>
		<key>_airhop-mesh-v1._tcp</key>
		<dict>
			<key>Publishable</key>
			<dict/>
			<key>Subscribable</key>
			<dict/>
		</dict>
	</dict>
</dict>
</plist>
