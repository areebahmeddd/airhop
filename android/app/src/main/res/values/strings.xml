<resources xmlns:tools="http://schemas.android.com/tools">
  <string name="app_name">Airhop</string>
  <string name="expo_system_ui_user_interface_style" translatable="false">automatic</string>
  <!-- The notice Android requires while the mesh runs in the background.
       Resolved against the system locale, not the in-app language picker. -->
  <string name="mesh_channel_name">Mesh network</string>
  <string name="mesh_channel_description">Keeps the Airhop mesh active in the background</string>
  <string name="mesh_notification_title">Airhop mesh active</string>
  <string name="mesh_notification_text">Discovering and relaying nearby messages</string>
  <string name="mesh_notification_stop">Stop mesh</string>
  <plurals name="mesh_notification_peers">
    <item quantity="one">%1$s peer in range</item>
    <item quantity="other">%1$s peers in range</item>
  </plurals>
  <!-- Bluetooth switched off with nobody reachable another way: the notice's
       line and the widget's message, worded as the Mesh tab's radar. -->
  <string name="mesh_bluetooth_off">Bluetooth off · not scanning</string>
  <!-- The home screen widget, on the notice's locale rule. The iOS widget's
       tables are written from these strings by scripts/i18n-check-native.js.
       The count is drawn on its own line above widget_in_range, so its forms
       carry no number, hence the ImpliedQuantity suppression in every
       language. -->
  <string name="widget_label">Peers in range</string>
  <string name="widget_description">Peers in range, and when they were counted</string>
  <plurals name="widget_in_range" tools:ignore="ImpliedQuantity">
    <item quantity="one">peer in range</item>
    <item quantity="other">peers in range</item>
  </plurals>
  <string name="widget_nobody">nobody in range</string>
  <string name="widget_as_of">as of %1$s</string>
  <string name="widget_paused">Mesh paused</string>
  <string name="widget_unset">Open Airhop</string>
  <string name="widget_stale">Open Airhop to refresh</string>
</resources>
