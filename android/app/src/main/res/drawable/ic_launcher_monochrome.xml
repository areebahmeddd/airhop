<?xml version="1.0" encoding="utf-8"?>
<!-- Themed-icon layer: the Airhop mark, 108dp adaptive-icon canvas.

     Generated from landing/public/brand/airhop-icon.svg, which is a pure grid of
     56px cells on a 1024px canvas. Because the mark is axis-aligned pixels and
     nothing else, it survives as a vector drawable exactly: one 1x1 cell per
     rect, scaled to the viewport below. No raster densities to keep in step and
     nothing to re-export when a density is added.

     To regenerate: read the rects out of that SVG, normalize them against the
     mark's bounding box (11 cells wide by 6 tall), and emit one
     "M<x>,<y>h<c>v<c>h-<c>z" per cell.
-->
<!--
     The monochrome layer Android 13+ uses when the user turns on themed icons.
     The system tints it from the wallpaper palette and reads only the alpha, so
     the fill color here is arbitrary.

     6dp per cell puts the mark at 66x36, which fits the 66dp safe zone of the
     108dp canvas exactly. Anything outside that zone is cropped by the launcher
     mask on some devices and not others.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
