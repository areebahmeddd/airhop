<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- Location is for location channels, not for Bluetooth. BLE needs no
       location from API 31 (neverForLocation below), so it is requested only
       when a location channel is opened. FINE is not capped at API 30: #block
       is geohash precision 7 (~150 m) and a coarse fix snaps to a far larger
       grid, so a coarse-only build would place people in the wrong cell. On
       API <=30 both are still required for BLE; utils/ble-permissions.ts
       knows the difference. -->
  <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
  <uses-permission android:name="android.permission.BLUETOOTH"/>
  <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"/>
  <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE"/>
  <uses-permission android:name="android.permission.BLUETOOTH_CONNECT"/>
  <!-- neverForLocation: a scan result is read for the service UUID, the peer
       ID in the scan response and RSSI, none of which is a position. The flag
       decouples the mesh from the location permission and toggle on API 31+,
       which is what lets discovery run in the background. The system scrubs
       iBeacon and Eddystone payloads in exchange; Airhop's 128-bit service
       data is untouched, so bitchat interop is unaffected. -->
  <uses-permission android:name="android.permission.BLUETOOTH_SCAN" android:usesPermissionFlags="neverForLocation"/>
  <uses-permission android:name="android.permission.CAMERA"/>
  <!-- ConnectivityManager.requestNetwork() throws SecurityException without
       this, and it is the only way to stand up a WiFi Aware data path.
       Discovery works without it, so the absence is invisible until two peers
       open a socket. Normal protection level, granted on install. -->
  <uses-permission android:name="android.permission.CHANGE_NETWORK_STATE"/>
  <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
  <!-- Lets the LAN transport hold a MulticastLock. WiFi power save drops
       multicast when the screen goes off, and mDNS is multicast, so without
       this discovery stops the moment the phone is pocketed. Normal protection
       level, granted on install. -->
  <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE"/>
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
  <!-- Required for Android 14+ to keep BLE active in a foreground service -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS"/>
  <!-- Android 13+ (API 33) runtime permission for WiFi Aware discovery. The
       same-platform WiFi fast path is optional, so a denial never blocks the
       BLE mesh. On API <=32 the location permissions above already cover it.

       neverForLocation for the same reason as BLUETOOTH_SCAN: a WiFi Aware peer
       handle is an opaque discovery token, not a position. bitchat/android
       declares the flag here too. -->
  <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES" android:usesPermissionFlags="neverForLocation"/>
  <!-- Android 17 gates local network access behind a runtime permission, and a
       WiFi Aware data path is a raw socket over a link-local IPv6 address, so
       it counts. Opt-in on Android 16 and enforced for apps targeting 17, which
       this one does not yet - declared now so the targetSdk bump does not
       silently break the fast path. It sits in the NEARBY_DEVICES group beside
       NEARBY_WIFI_DEVICES, so granting one covers the other and the user sees
       no second dialog. -->
  <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK"/>
  <!-- Android 13+ runtime permission for local message notifications -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
  <!-- Hands a downloaded release APK to the system installer, for the update
       path on the Version screen: users with no reachable store still need a
       way to get a fix. It only opens the installer; the user confirms in a
       system dialog, "Install unknown apps" must be allowed, and Android
       refuses an APK not signed by the release key. Strip it, and the download
       path with it, from any Play-distributed flavour: Play forbids an app
       updating itself by any other route. -->
  <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
  <uses-permission android:name="android.permission.READ_MEDIA_IMAGES"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VIDEO"/>
  <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED"/>
  <uses-permission android:name="android.permission.RECORD_AUDIO"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <!-- Hardware, stated explicitly. Play hides an app from devices lacking a
       required feature and infers requirements from permissions: CAMERA
       implies an autofocus camera and RECORD_AUDIO a microphone, neither of
       which the mesh needs, while nothing implies Bluetooth LE, the one thing
       it cannot run without. bitchat/android declares the same set. -->
  <uses-feature android:name="android.hardware.bluetooth" android:required="true"/>
  <uses-feature android:name="android.hardware.bluetooth_le" android:required="true"/>
  <!-- QR scanning and capture are optional: a contact can be added from a link
       and attachments picked from the library. -->
  <uses-feature android:name="android.hardware.camera" android:required="false"/>
  <uses-feature android:name="android.hardware.camera.autofocus" android:required="false"/>
  <!-- Voice notes and push-to-talk are optional. -->
  <uses-feature android:name="android.hardware.microphone" android:required="false"/>
  <!-- The same-platform fast path is optional; phones without it run on the
       BLE mesh. -->
  <uses-feature android:name="android.hardware.wifi.aware" android:required="false"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <!-- enableOnBackInvokedCallback stays false. React Native 0.86's
       ReactActivity registers its OnBackPressedCallback only on API 36+ with
       targetSdk 36+, where the platform enforces predictive back regardless.
       Below that, true would route back through OnBackPressedDispatcher,
       bypassing the onBackPressed() override that reaches BackHandler, and
       every in-app back would close the app on Android 13 to 15. Revisit when
       React Native registers its callback unconditionally. -->
  <!-- Puts Airhop under Settings > Apps > Airhop > Language on Android 13, so
       someone whose system language Airhop does not ship can still pick one it
       does. Reaches only the strings the OS renders. Inert below API 33. -->
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="false" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:requestLegacyExternalStorage="true" android:localeConfig="@xml/locales_config" tools:targetApi="33">
    <!-- Android 16 ignores the portrait lock on any display at least 600dp
         wide (a foldable's inner screen, a tablet, a desktop window). The shell
         has no breakpoints and is laid out for a phone in portrait, so
         compatibility mode is the better experience. Android 17 removed this
         opt-out, so it stops applying there whatever the targetSdk; the app
         still renders on a large display, only unpolished. -->
    <property android:name="android.window.PROPERTY_COMPAT_ALLOW_RESTRICTED_RESIZABILITY" android:value="true"/>
    <!-- Read by expo-notifications at runtime. Written here rather than through
         the config plugin because prebuild is never run in this repo, so the
         plugin's app.json options would generate nothing. Without them a
         notification falls back to the launcher icon, which Android renders
         through its mask as a white blob. AirhopForegroundService uses the same
         pair so the two notices look like one app. -->
    <meta-data android:name="expo.modules.notifications.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <!-- No expo-audio AudioControlsService and no
         FOREGROUND_SERVICE_MEDIA_PLAYBACK: the service starts only from
         AudioPlayer.setActiveForLockScreen(), which Airhop never calls, and
         each foreground-service type declared costs a separate Play review.
         If lock-screen controls are ever wanted, the permission and the service
         come back together; one without the other crashes on Android 14+. -->
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize|assetsPaths" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <!-- Airhop deep links: airhop://channel/<name>, airhop://peer/<id> -->
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="airhop"/>
      </intent-filter>
    </activity>
    <!-- Keeps the mesh radios running with the app off screen. -->
    <service
      android:name="org.onemindlabs.airhop.service.AirhopForegroundService"
      android:foregroundServiceType="connectedDevice"
      android:exported="false"/>
  </application>
</manifest>